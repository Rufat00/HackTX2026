{
  "version": 1,
  "name": "afterglow-light",
  "primitives": {
    "color": {
      "canvas": "#F6F6F6",
      "white": "#FFFFFF",
      "ink": "#0B0B0B",
      "gray900": "#242424",
      "gray700": "#626262",
      "gray500": "#929292",
      "gray300": "#D8D8D8",
      "gray100": "#ECECEC",
      "blue700": "#006AB5",
      "red700": "#B4232C",
      "green700": "#246B3C",
      "green50": "#EAF4ED",
      "red50": "#FCEEF0",
      "blue50": "#E8F2FA",
      "scrim": "rgba(0, 0, 0, 0.22)"
    },
    "space": {
      "none": 0,
      "xs": 4,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 24,
      "xxl": 32,
      "section": 48
    },
    "radius": {
      "small": 8,
      "memory": 16,
      "card": 24,
      "sheet": 32,
      "pill": 999
    },
    "border": {
      "hairline": 1,
      "focus": 2
    },
    "opacity": {
      "disabled": 0.5,
      "pressed": 0.78
    },
    "icon": {
      "small": 18,
      "regular": 22,
      "large": 32
    },
    "control": {
      "touch": 44,
      "regular": 52
    },
    "avatar": {
      "sm": 32,
      "md": 44,
      "lg": 96,
      "overlap": 8
    },
    "layout": {
      "contentMaxWidth": 520,
      "dialogMaxWidth": 360,
      "sheetMaxWidth": 640,
      "mediaAspectRatio": 1.25,
      "mediaMinHeight": 160,
      "skeletonLine": 16,
      "handleWidth": 36,
      "handleHeight": 4
    },
    "type": {
      "display": {
        "fontSize": 32,
        "lineHeight": 38,
        "fontWeight": "600"
      },
      "title": {
        "fontSize": 24,
        "lineHeight": 30,
        "fontWeight": "600"
      },
      "heading": {
        "fontSize": 20,
        "lineHeight": 26,
        "fontWeight": "600"
      },
      "body": {
        "fontSize": 16,
        "lineHeight": 24,
        "fontWeight": "400"
      },
      "label": {
        "fontSize": 16,
        "lineHeight": 22,
        "fontWeight": "600"
      },
      "caption": {
        "fontSize": 13,
        "lineHeight": 18,
        "fontWeight": "400"
      },
      "hero": {
        "fontSize": 48,
        "lineHeight": 54,
        "fontWeight": "600"
      },
      "quote": {
        "fontSize": 80,
        "lineHeight": 80,
        "fontWeight": "600"
      }
    },
    "shadow": {
      "color": "#000000",
      "opacity": 0.07,
      "radius": 12,
      "offsetY": 4,
      "elevation": 2
    }
  },
  "semantic": {
    "background": "$primitives.color.canvas",
    "surface": "$primitives.color.white",
    "surfaceMuted": "$primitives.color.gray100",
    "surfaceElevated": "$primitives.color.white",
    "textPrimary": "$primitives.color.ink",
    "textSecondary": "$primitives.color.gray700",
    "textDisabled": "$primitives.color.gray500",
    "accent": "$primitives.color.ink",
    "onAccent": "$primitives.color.white",
    "selected": "$primitives.color.ink",
    "onSelected": "$primitives.color.white",
    "border": "$primitives.color.gray300",
    "controlBorder": "$primitives.color.gray700",
    "focus": "$primitives.color.blue700",
    "danger": "$primitives.color.red700",
    "dangerSurface": "$primitives.color.red50",
    "success": "$primitives.color.green700",
    "successSurface": "$primitives.color.green50",
    "suggestion": "$primitives.color.blue700",
    "suggestionSurface": "$primitives.color.blue50",
    "overlay": "$primitives.color.scrim"
  },
  "component": {
    "button": {
      "minHeight": "$primitives.control.regular",
      "paddingX": "$primitives.space.xl",
      "paddingY": "$primitives.space.md",
      "radius": "$primitives.radius.pill"
    },
    "field": {
      "minHeight": "$primitives.control.regular",
      "radius": "$primitives.radius.memory",
      "padding": "$primitives.space.lg"
    },
    "card": {
      "radius": "$primitives.radius.card",
      "padding": "$primitives.space.lg"
    },
    "chip": {
      "minHeight": "$primitives.control.touch",
      "radius": "$primitives.radius.pill",
      "paddingX": "$primitives.space.lg"
    },
    "navigation": {
      "minHeight": "$primitives.control.touch",
      "gap": "$primitives.space.sm",
      "addSize": 60,
      "barMaxWidth": 360
    },
    "sheet": {
      "radius": "$primitives.radius.sheet",
      "padding": "$primitives.space.xl"
    },
    "memory": {
      "width": 308,
      "gutter": 16,
      "verticalGrid": 8,
      "radius": "$primitives.radius.memory",
      "padding": "$primitives.space.lg",
      "fogWidth": 40,
      "fogColor": "rgba(11, 11, 11, 0.96)",
      "storySurface": "rgba(11, 11, 11, 0.88)",
      "songArtworkSize": 88,
      "imageRadius": 8
    },
    "avatar": {
      "sm": "$primitives.avatar.sm",
      "md": "$primitives.avatar.md",
      "lg": "$primitives.avatar.lg",
      "overlap": "$primitives.avatar.overlap"
    },
    "auth": {
      "brandTracking": -1,
      "titleTracking": -1,
      "heroTracking": -2
    },
    "editor": {
      "background": "$primitives.color.ink",
      "surface": "$primitives.color.gray900",
      "text": "$primitives.color.white",
      "secondary": "$primitives.color.gray300",
      "border": "$primitives.color.gray700",
      "photoSize": 180,
      "writingMinHeight": 280
    }
  }
}
