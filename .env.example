NODE_ENV=development
HOST=0.0.0.0
PORT=3001
DATABASE_URL=postgresql://afterglow:afterglow_dev@localhost:5432/afterglow
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
API_URL=http://localhost:3001
TRUSTED_ORIGINS=afterglow://,http://localhost:3001
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=afterglow-private
S3_ACCESS_KEY_ID=afterglow_local
S3_SECRET_ACCESS_KEY=afterglow_local_storage_only
S3_FORCE_PATH_STYLE=true
# Use openai with a server-only OPENAI_API_KEY to enable paid semantic composition.
AI_COMPOSITION_PROVIDER=fixture
AI_COMPOSITION_MODEL=gpt-6.1-sol
# OPENAI_API_KEY=server-only; optional; never an EXPO_PUBLIC variable
# Native memory and profile photos use the API proxy; storage only needs server access.
# Copy this one public value to apps/mobile/.env:
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:3001

# Optional local-only seed password (required by pnpm db:seed):
# DEV_SEED_PASSWORD=choose-a-unique-development-passphrase
# Required only for pnpm test:integration; must end in _test:
# TEST_DATABASE_URL=postgresql://afterglow:afterglow_dev@localhost:5432/afterglow_test
